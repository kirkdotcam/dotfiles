# ~/.config/ghostty/config.ghostty

# Theme
# Theme names are case-sensitive. Verify exact name with:
#   ghostty +list-themes | grep -i oxo
theme = Oxocarbon

# Transparent background
# 1.0 = opaque, 0.0 = fully transparent
background-opacity = 0.82

# Helps transparency work better inside apps that paint their own cell background,
# such as Neovim/tmux. Requires Ghostty 1.2.0+.
background-opacity-cells = true

# Optional; supported only on some Linux desktops/compositors.
# GNOME support may vary.
background-blur = false

# Make unfocused splits more transparent/dimmed than the focused split.
# Valid range is 0.15–1.0.
unfocused-split-opacity = 0.55

# Oxocarbon-ish dark fill for the unfocused overlay.
unfocused-split-fill = #161616

# Split divider
split-divider-color = #393939

# Remove GNOME/GTK titlebar/window frame where the window manager allows it.
window-decoration = none

# Optional GTK-specific titlebar behavior.
# This is ignored when window-decoration = none, but keeps intent clear.
gtk-titlebar = false

font-size = 14
